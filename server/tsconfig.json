{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"],
        "baseUrl": ".",
        "paths": { },
        "rootDir": "src",
        "outDir": "dist",
        "resolveJsonModule": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["src/**/*.ts"]
}