generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int                 @id @default(autoincrement())
  email       String              @unique
  username    String              @unique
  isAdmin     Boolean             @default(false)
  teamSeasons FantasyTeamSeason[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model League {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  settings  LeagueSettings?
  teams     FantasyTeam[]
  seasons   LeagueSeason[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model LeagueSettings {
  id       Int    @id @default(autoincrement())
  leagueId Int    @unique
  league   League @relation(fields: [leagueId], references: [id])

  // classic non-PPR defaults 
  passYdsPerPt Float @default(0.04)
  passTDPts    Float @default(4)
  passIntPts   Float @default(-2)
  rushYdsPerPt Float @default(0.1)
  rushTDPts    Float @default(6)
  recYdsPerPt  Float @default(0.1)
  recTDPts     Float @default(6)
  ppr          Float @default(0)
  fgMadePts    Float @default(3)
  fgMissPts    Float @default(-1)
  xpMadePts    Float @default(1)
  xpMissPts    Float @default(-1)

  qbStarters   Int @default(1)
  rbStarters   Int @default(2)
  wrStarters   Int @default(2)
  teStarters   Int @default(1)
  flexStarters Int @default(1)
  dstStarters  Int @default(1)
  kStarters    Int @default(1)
  benchSpots   Int @default(7)
  irSpots      Int @default(1)
}

model LeagueSeason {
  id       Int @id @default(autoincrement())
  leagueId Int
  season   Int

  league League @relation(fields: [leagueId], references: [id])

  draft Draft?

  teams    FantasyTeamSeason[]
  matchups FantasyMatchup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, season])
  @@index([season])
}

model FantasyTeam {
  id       Int    @id @default(autoincrement())
  name     String
  leagueId Int
  league   League @relation(fields: [leagueId], references: [id])

  seasons FantasyTeamSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, name]) // unique team name for each league
  @@index([leagueId])
}

model FantasyTeamSeason {
  id            Int  @id @default(autoincrement())
  seasonId      Int
  fantasyTeamId Int
  managerId     Int?

  name String // Allows a team name to change from year to year

  season      LeagueSeason @relation(fields: [seasonId], references: [id])
  fantasyTeam FantasyTeam  @relation(fields: [fantasyTeamId], references: [id])
  manager     User?        @relation(fields: [managerId], references: [id])

  draftParticipants DraftParticipant[]
  draftPicks        DraftPick[]

  homeMatchups FantasyMatchup[] @relation("HomeFantasyTeamSeason")
  awayMatchups FantasyMatchup[] @relation("AwayFantasyTeamSeason")

  slots RosterSlot[] @relation("FantasyTeamSeasonRosterSlots")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, fantasyTeamId]) // a permanent fantasy team can appear only once in a league season.
  @@unique([seasonId, managerId]) //a manager can manage only one team in a league season.
  @@unique([id, seasonId]) // supports RosterSlot's compound seasonal-team relationship.
  @@index([managerId])
  @@index([fantasyTeamId])
}

model Draft {
  id Int @id @default(autoincrement())

  leagueSeasonId Int          @unique
  leagueSeason   LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)

  status             DraftStatus @default(SETUP)
  rounds             Int         @default(17)
  currentOverallPick Int         @default(1)

  participants DraftParticipant[]
  picks        DraftPick[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DraftParticipant {
  id Int @id @default(autoincrement())

  draftId             Int
  fantasyTeamSeasonId Int
  draftPosition       Int

  draft             Draft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
  fantasyTeamSeason FantasyTeamSeason @relation(fields: [fantasyTeamSeasonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([draftId, fantasyTeamSeasonId])
  @@unique([draftId, draftPosition])
  @@index([fantasyTeamSeasonId])
}

model DraftPick {
  id Int @id @default(autoincrement())

  draftId             Int
  fantasyTeamSeasonId Int
  playerId            Int
  overallPick         Int
  round               Int
  pickInRound         Int

  draft             Draft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
  fantasyTeamSeason FantasyTeamSeason @relation(fields: [fantasyTeamSeasonId], references: [id])
  player            Player            @relation(fields: [playerId], references: [id])

  madeAt DateTime @default(now())

  @@unique([draftId, overallPick])
  @@unique([draftId, playerId])
  @@index([fantasyTeamSeasonId, overallPick])
  @@index([playerId])
}

model FantasyMatchup {
  id       Int @id @default(autoincrement())
  seasonId Int
  week     Int

  homeTeamSeasonId Int
  awayTeamSeasonId Int

  homeScore Decimal? @db.Decimal(10, 2)
  awayScore Decimal? @db.Decimal(10, 2)

  type   FantasyMatchupType   @default(REGULAR_SEASON)
  status FantasyMatchupStatus @default(SCHEDULED)

  season         LeagueSeason      @relation(fields: [seasonId], references: [id])
  homeTeamSeason FantasyTeamSeason @relation("HomeFantasyTeamSeason", fields: [homeTeamSeasonId], references: [id])
  awayTeamSeason FantasyTeamSeason @relation("AwayFantasyTeamSeason", fields: [awayTeamSeasonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // uniques = a fantasy team cannot appear as home team/away team in two different matchups during the same week
  @@unique([seasonId, week, homeTeamSeasonId])
  @@unique([seasonId, week, awayTeamSeasonId])
  @@index([seasonId, week])
}

model RosterSlot {
  id Int @id @default(autoincrement())

  leagueSeasonId      Int
  fantasyTeamSeasonId Int
  fantasyTeamSeason   FantasyTeamSeason @relation("FantasyTeamSeasonRosterSlots", fields: [fantasyTeamSeasonId, leagueSeasonId], references: [id, seasonId], onDelete: Cascade)

  playerId Int?
  player   Player?  @relation(fields: [playerId], references: [id]) // Player = existing model for NFL player 
  slot     SlotType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueSeasonId, playerId]) // prevents same player on two different teams in the same league
  // common queries
  @@index([fantasyTeamSeasonId, slot])
  @@index([leagueSeasonId, slot])
  @@index([playerId])
}

model Team {
  id               Int      @id @default(autoincrement())
  abbr             String   @unique
  name             String
  players          Player[]
  logoUrl          String?
  byeWeeksBySeason Json?
  homeGames        Game[]   @relation("homeTeam")
  awayGames        Game[]   @relation("awayTeam")
}

model Player {
  id          Int     @id @default(autoincrement())
  name        String
  position    String
  teamId      Int?
  team        Team?   @relation(fields: [teamId], references: [id])
  headshotUrl String?
  externalId  String? @unique
  externalSrc String?

  draftPicks   DraftPick[]
  projPts      Float?
  adp          Float?
  lastSyncedAt DateTime?
  RosterSlot   RosterSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalSrc, externalId])
  @@index([name])
  @@index([position])
  @@index([teamId, position])
}

model Game {
  id        Int       @id @default(autoincrement())
  season    Int
  week      Int
  startTime DateTime? //optional for null
  venue     String?
  status    String    @default("scheduled")
  isFlexed  Boolean   @default(false)

  // External mapping for Tank/ESPN/etc.
  externalGameId String? @unique
  externalSrc    String?

  // Relations to existing Team Model
  homeTeamId Int
  awayTeamId Int
  homeTeam   Team @relation("homeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team @relation("awayTeam", fields: [awayTeamId], references: [id])

  // Prevent dupes when re-seeding
  @@unique([season, week, homeTeamId, awayTeamId, startTime])
  @@index([season, week])
}

enum SlotType {
  QB
  RB
  WR
  TE
  FLEX
  DST
  K
  BN
  IR
}

enum DraftStatus {
  SETUP
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum FantasyMatchupType {
  REGULAR_SEASON
  PLAYOFF
  CONSOLATION
  CHAMPIONSHIP
}

enum FantasyMatchupStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
}

// docs: https://pris.ly/d/prisma-schema
