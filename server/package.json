{
  "name": "fantasy-football-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "serve": "tsx src/index.ts",
    "db:seed": "tsx src/seeds/seed-league.ts",
    "db:seed:players": "tsx src/seeds/seed-players.ts",
    "db:seed:dst": "tsx src/seeds/seed-dst.ts",
    "db:seed:rosters": "tsx src/seeds/seed-roster-template.ts",
    "teams:import:nfl-teams": "tsx src/scripts/import-nfl-teams.ts",
    "teams:backfill-byes": "tsx src/scripts/backfill-bye-weeks.ts",
    "migrate": "prisma migrate dev",
    "sync:players": "tsx src/scripts/sync-tank-players",
    "studio": "prisma studio",
    "generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/seeds/seed-league.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "prisma": "^6.17.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
